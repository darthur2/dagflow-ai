{
  "$schema": "https://opencode.ai/config.json",
  "model": "ssec-litellm/gpt-5.4-mini",
  "provider": {
    "ssec-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llmaven-prod-litellm-prod.lemonmoss-19296c81.westus2.azurecontainerapps.io/"
      },
      "models": {
        "gemma-4-31b": {},
        "gpt-5.4-mini": {},
        "kimi-k2-thinking": {}
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "models": {
        "gpt-4o": {},
        "gpt-5.4-mini": {},
        "gpt-5.4-nano": {}
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic",
      "models": {
        "claude-sonnet-4-20250514": {}
      }
    }
  },
  "autoshare": false,
  "autoupdate": false,
  "default_agent": "synthesizer",
  "agent": {
    "synthesizer": {
      "mode": "primary",
      "model": "ssec-litellm/gpt-5.4-mini",
      "description": "Default orchestrator for synthetic dataset generation. Delegates work to specialized domain agents.",
      "prompt": "{file:./prompts/synthesizer.md}",
      "permission": {
        "read": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow",
          "python/scripts": "allow",
          "python/scripts/": "allow",
          "python/scripts/*": "allow"
        },
        "glob": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow",
          "python/scripts": "allow",
          "python/scripts/": "allow",
          "python/scripts/*": "allow"
        },
        "grep": "deny",
        "list": "allow",
        "question": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "python python/scripts/validators.py": "allow",
          "python python/scripts/data_generator.py": "allow"
        },
        "external_directory": "deny",
        "todowrite": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "doom_loop": "deny",
        "task": {
          "*": "deny",
          "variables": "allow",
          "dag": "allow",
          "distributions": "allow",
          "formulas": "allow"
        }
      }
    },
    "variables": {
      "mode": "subagent",
      "description": "Manage a JSON variable list called variables.json",
      "prompt": "{file:./prompts/variables.md}",
      "permission": {
        "read": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "glob": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "grep": "deny",
        "list": "deny",
        "question": "deny",
        "edit": {
          "*": "deny",
          "synthdata/variables.json": "allow"
        },
        "bash": "deny",
        "external_directory": "deny",
        "todowrite": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "doom_loop": "deny",
        "task": "deny"
      }
    },
    "dag": {
      "mode": "subagent",
      "description": "Manage a JSON list called dag.json containing information about a Directed Acyclic Graph (DAG).",
