        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "doom_loop": "deny",
        "task": "deny"
      }
    },
    "distributions": {
      "mode": "subagent",
      "description": "Manage a JSON distribution list called distributions.json",
      "prompt": "{file:./prompts/distributions.md}",
      "permission": {
        "read": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "glob": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "grep": "deny",
        "list": "deny",
        "question": "deny",
        "edit": {
          "*": "deny",
