          "synthdata/*": "allow"
        },
        "glob": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "grep": "deny",
        "list": "deny",
        "question": "deny",
        "edit": {
          "*": "deny",
          "synthdata/formulas.json": "allow"
        },
        "bash": "deny",
        "external_directory": "deny",
        "todowrite": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
