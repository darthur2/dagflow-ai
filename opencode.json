      "permission": {
        "read": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "glob": {
          "*": "deny",
          "synthdata": "allow",
          "synthdata/": "allow",
          "synthdata/*": "allow"
        },
        "grep": "deny",
        "list": "deny",
        "question": "deny",
        "edit": {
          "*": "deny",
