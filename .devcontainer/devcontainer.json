{
  "name": "DagFlow",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "forwardPorts": [3838],
  "postCreateCommand": "bash -lc 'test -d .opencode && cd .opencode && npm install'",
  "postStartCommand": "bash -lc 'exec opencode'",
  "customizations": {
    "vscode": {
      "extensions": [
        "reditorsupport.r"
      ]
    }
  }
}
